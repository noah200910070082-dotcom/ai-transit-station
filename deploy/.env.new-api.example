POSTGRES_USER=root
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=new-api
REDIS_PASSWORD=change-this-redis-password

SQL_DSN=postgresql://root:change-this-postgres-password@postgres:5432/new-api
REDIS_CONN_STRING=redis://:change-this-redis-password@redis:6379
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=vps-new-api-node-1
SESSION_SECRET=change-this-session-secret
FRONTEND_BASE_URL=https://your-vercel-domain.vercel.app

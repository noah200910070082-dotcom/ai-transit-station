POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_DB=new-api
REDIS_PASSWORD=replace-with-a-random-local-password

SQL_DSN=postgresql://root:replace-with-a-random-local-password@postgres:5432/new-api
REDIS_CONN_STRING=redis://:replace-with-a-random-local-password@redis:6379
TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=local-new-api-node
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_COOKIE_SECURE=false
FRONTEND_BASE_URL=http://127.0.0.1:5173

NEW_API_ADMIN_USERNAME=admin
NEW_API_ADMIN_PASSWORD=replace-with-a-random-admin-password
